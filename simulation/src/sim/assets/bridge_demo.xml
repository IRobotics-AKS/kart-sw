<mujoco model="bridge_test_body_not_a_kart">
  <!-- Synthetic bridge fixture. Dimensions/noise are not kart measurements. -->
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <worldbody>
    <light pos="0 0 3"/>
    <geom type="plane" size="3 3 0.1" rgba="0.3 0.4 0.3 1"/>
    <body name="base_link" pos="0 0 1">
      <joint name="x" type="slide" axis="1 0 0"/>
      <joint name="y" type="slide" axis="0 1 0"/>
      <joint name="z" type="slide" axis="0 0 1"/>
      <joint name="yaw" type="hinge" axis="0 0 1"/>
      <geom type="box" size="0.2 0.1 0.1" mass="1" rgba="0.9 0.5 0.1 1"/>
      <site name="imu_site" size="0.01"/>
    </body>
  </worldbody>
  <sensor>
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
  </sensor>
  <!-- Arbitrary test limits, not physical vehicle actuator specifications. -->
  <actuator>
    <motor name="x_force" joint="x" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
    <motor name="yaw_torque" joint="yaw" gear="1" ctrllimited="true" ctrlrange="-2 2"/>
  </actuator>
</mujoco>
