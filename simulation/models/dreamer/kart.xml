    <texture name="ground_grid" type="2d" builtin="checker"
             rgb1="0.24 0.27 0.30" rgb2="0.34 0.37 0.40" width="512" height="512"/>
    <material name="ground" texture="ground_grid" texrepeat="12 12" texuniform="true"/>
    <material name="frame_blue" rgba="0.02 0.18 0.75 1" specular="0.6"/>
    <material name="body_blue" rgba="0.03 0.28 0.9 1"/>
    <material name="yellow" rgba="1 0.85 0.03 1"/>
    <material name="rubber" rgba="0.035 0.035 0.04 1"/>
    <material name="metal" rgba="0.65 0.68 0.72 1" specular="0.8"/>
    <material name="dark" rgba="0.15 0.16 0.18 1"/>
    <material name="seat" rgba="0.12 0.13 0.15 1"/>
    <material name="ballast" rgba="0.45 0.30 0.20 1"/>
    <material name="collision" rgba="1 0.2 0.2 0.35"/>

    <mesh name="frame" file="frame.stl"/>
    <mesh name="rim_front" file="rim_front.stl"/>
    <mesh name="rim_rear" file="rim_rear.stl"/>
    <mesh name="tyre_front" file="tyre_front.stl"/>
    <mesh name="tyre_rear" file="tyre_rear.stl"/>
    <mesh name="hub_rear" file="hub_rear.stl"/>
    <mesh name="sprocket_hub" file="sprocket_hub.stl"/>
    <mesh name="brake_rotor" file="brake_rotor.stl"/>
    <mesh name="caliper" file="caliper.stl"/>
    <mesh name="engine_mount" file="engine_mount.stl"/>
  </asset>
  <default>
    <joint damping="0.02"/>
    <!-- Visual pieces: no collision, no mass (every moving body has an explicit inertial). -->
    <geom contype="0" conaffinity="0" group="0"/>
    <default class="cad">
      <geom type="mesh" material="metal"/>
    </default>
    <!-- Collision geoms: hit the world (contype 1 / conaffinity 1), never the kart itself. -->
    <default class="col">
      <geom contype="2" conaffinity="1" condim="3" group="3" material="collision" friction="0.6 0.005 0.0001"/>
      <default class="frame_col">
        <geom type="capsule"/>
      </default>
      <default class="mesh_col">
        <geom type="mesh"/>
      </default>
      <default class="tire">
        <geom type="cylinder" euler="1.57079632679 0 0" condim="4" friction="0.9 0.005 0.0001"/>
      </default>
    </default>
  </default>
