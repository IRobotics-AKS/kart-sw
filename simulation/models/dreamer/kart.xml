  <!-- Tie rods: both front wheels steer together (parallel steering; Ackermann not modelled
       until the steering-arm geometry is measured). Without this the caster/KPI geometry
       lets the free pivots splay out under the kart's weight. -->
  <equality>
    <joint name="tie_rod" joint1="front_right_steer" joint2="front_left_steer" polycoef="0 1 0 0 0"/>
  </equality>

  <actuator>
    <!-- Steering motor on the column (BoM: 2400 W outrunner + VESC), as a servo on the wheel
         angle. ctrl = front wheel angle in rad, + = left. +-25 deg lock is a placeholder. -->
    <position name="steer" joint="front_left_steer" kp="800" kv="15"
              ctrlrange="-0.4363 0.4363" forcerange="-200 200"/>
    <!-- Drive: ME1716 torque through the chain to the rear axle. ctrl = axle torque in N m
         (+ = forward, - = regen). Capped at 70 N m = 500 N at the rear tyres (the drive limit
         the aks-gps sim uses), below the rear tyres' grip (~92 N m): MuJoCo's tyre friction
         gives almost no thrust once a wheel spins, so more torque makes the kart slower.
         Not modelled here: the motor's speed limit (~4500 rpm / ~5.5:1 -> ~12 m/s),
         current/power limits and response lag; the control code has to apply them. -->
    <motor name="drive" joint="rear_axle_spin" gear="1" ctrlrange="-70 70"/>
    <!-- Brake: hydraulic rear disc. ctrl = 0..1 pedal. Modelled as a damper on the axle
         (torque = -kv x axle speed x ctrl, capped at 210 N m = ~1500 N at the rear tyres),
         so it never pushes the kart backwards; it is weak below ~1 m/s. -->
    <damper name="brake" joint="rear_axle_spin" kv="5" ctrlrange="0 1" forcerange="-210 210"/>
  </actuator>
</mujoco>
