# Local development image tags; build the corresponding Dockerfile first.
SIMULATION_IMAGE=kart-simulation:scaffold
AUTONOMY_IMAGE=kart-autonomy:scaffold
HARDWARE_IMAGE=kart-hardware:scaffold
RECORDER_IMAGE=kart-recorder:scaffold
# Illustrative discovery IDs only, not physical safety boundaries.
SIM_ROS_DOMAIN_ID=41
LIVE_ROS_DOMAIN_ID=42
NAMESPACE=kart
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Set this only for development.override.yaml:
# REPO_ROOT=/absolute/path/to/kart-sw
